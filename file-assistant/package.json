{
  "name": "file-assistant",
  "version": "1.0.0",
  "description": "MCP server for file system operations: read, write, edit, search, glob",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "express": "^4.18.0",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "simple-git": "^3.36.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/diff": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
