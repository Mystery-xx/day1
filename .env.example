# AI API Configuration
AI_API_KEY=your-api-key-here
AI_API_URL=
AI_MODEL=
AI_PROVIDER=gpustack

# Provider-specific URLs (optional)
# GPUStack: http://gpustack.example.com/v1
# HuggingFace: https://router.huggingface.co/v1
GPUSTACK_API_URL=
HUGGINGFACE_API_URL=https://router.huggingface.co/v1
HUGGINGFACE_TOKEN=your-huggingface-token-here

# Model Settings (optional, defaults shown)
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_TOP_P=1.0
AI_FREQUENCY_PENALTY=0.0
AI_PRESENCE_PENALTY=0.0
# AI_STOP=seq1,seq2

# Docker Configuration
DOCKER_FRONTEND_PORT=5173
DOCKER_BACKEND_PORT=8080

# Ollama Configuration
# Use host.docker.internal to access Ollama from Docker containers
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# TEI Reranker Configuration
# URL for Text Embeddings Inference reranker service
# Used for RAG reranking to improve search result relevance
TEI_RERANKER_URL=http://tei-reranker:80

# RAG Query Rewrite Configuration
# Model settings for query rewrite functionality
RAG_QUERY_REWRITE_MODEL=default-rewrite
RAG_QUERY_REWRITE_TIMEOUT_SECONDS=30
